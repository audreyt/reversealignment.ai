---
/**
 * /events/you-are-here/ — the post-event record for the 29 Aug 2026 Taipei talk.
 *
 * The public transcript is canonical. This page keeps the five-role map as
 * provenance, then recodes the eleven answer chapters into a navigable spine.
 * It sits two levels deep, so every asset and home link is relative to the
 * current locale tree rather than escaping `/en/` on the zh-TW host.
 */
import CtaLink from '../../components/CtaLink.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { assetPath, getContent, getDefaultLocale, relativeRootPath } from '../../lib/i18n';

const locale = getDefaultLocale();
const catalog = getContent(locale);
const event = catalog.event;
const { record, principles, questions, map, archetypes, speakers } = event;
const rootPath = relativeRootPath(Astro.url.pathname);

// Every nav and footer link is a homepage anchor. From two levels down they
// have to climb, or they resolve against this page and go nowhere.
const copy = {
  ...catalog,
  nav: {
    ...catalog.nav,
    coalition: { ...catalog.nav.coalition, href: `${rootPath}${catalog.nav.coalition.href}` },
  },
  footer: {
    ...catalog.footer,
    columns: catalog.footer.columns.map((column) => ({
      ...column,
      links: column.links.map((link) => ({ ...link, href: `${rootPath}${link.href}` })),
    })),
  },
};

// The machine-readable instant lives once, in the catalog listing this page
// belongs to. A missing id means the page is advertising an unlisted event.
const listing = catalog.coalition.events.find((item) => item.id === event.eventId);
if (!listing) {
  throw new Error(`event.eventId "${event.eventId}" has no coalition.events entry`);
}

const title = `${event.metaTitle} — ${catalog.brand.name}`;
const mapImage = assetPath('event-archetype-map', locale, rootPath);
const archetypeImageDimensions: Record<string, { width: number; height: number }> = {
  bridgewright: { width: 233, height: 435 },
  weaver: { width: 258, height: 405 },
  craftkeeper: { width: 258, height: 448 },
  companion: { width: 251, height: 530 },
  translator: { width: 300, height: 500 },
};
function getArchetypeImageDimensions(id: string) {
  const dimensions = archetypeImageDimensions[id];
  if (!dimensions) throw new Error(`Missing event archetype image dimensions for "${id}"`);
  return dimensions;
}

let questionOrdinal = 0;
const questionGroups = questions.groups.map((group) => ({
  ...group,
  items: group.items.map((item) => ({
    ...item,
    number: String(++questionOrdinal).padStart(2, '0'),
  })),
}));
---

<Base locale={locale} title={title} description={event.metaDescription} image={catalog.assets['og-image-event']}>
  <div id="top" class="page page--event">
    <SiteHeader copy={copy} showNavigation={false} />

    <main id="main">
      <section class="section section--dark event-hero" aria-labelledby="event-title">
        <div class="section__inner event-hero__grid">
          <div class="event-hero__copy">
            <p class="eyebrow">{event.eyebrow}</p>
            <h1 id="event-title" class="display display--xl event-hero__title">{event.title}</h1>
            <p class="lede event-hero__subtitle">{event.subtitle}</p>
            <p class="body event-hero__body">{event.body}</p>

            <dl class="event-stats">
              {
                event.stats.map((stat) => (
                  <div class="event-stats__item">
                    <dt class="event-stats__label">{stat.label}</dt>
                    <dd class="event-stats__value">{stat.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <figure class="event-hero__figure">
            <img
              class="event-hero__image"
              src={mapImage}
              alt={map.imageAlt}
              width="1254"
              height="1254"
              loading="eager"
              decoding="async"
            />
            <figcaption class="body--sm event-hero__caption">{map.caption}</figcaption>
          </figure>
        </div>
      </section>

      <section class="event-record-band" aria-labelledby="event-record-title">
        <div class="event-record">
          <div class="event-record__mast">
            <p class="eyebrow event-record__eyebrow">{record.eyebrow}</p>
            <h2 id="event-record-title" class="display display--md event-record__title">
              {record.title}
            </h2>
          </div>
          <div class="event-record__copy">
            <p class="event-record__meta">
              <time datetime={listing.startsAt}>{record.when}</time>
              <span aria-hidden="true"> · </span>
              {record.place}
            </p>
            <p class="event-record__body">{record.body}</p>
            <CtaLink
              cta={record.transcript}
              class="btn btn--dark event-record__cta"
              externalLabel={copy.a11y.externalLink}
            />
            {
              record.altTranscript && (
                <CtaLink
                  cta={record.altTranscript}
                  class="event-record__alt"
                  externalLabel={copy.a11y.externalLink}
                />
              )
            }
          </div>
        </div>
      </section>

      <section
        class="section section--event-light event-principles"
        aria-labelledby="event-principles-title"
      >
        <div class="section__inner">
          <div class="event-head event-head--split">
            <h2 id="event-principles-title" class="display display--md">{principles.title}</h2>
            <p class="body event-head__lead">{principles.lead}</p>
          </div>

          <ol class="event-principle-list">
            {
              principles.items.map((principle, index) => (
                <li class="event-principle" data-principle={principle.id}>
                  <p class="event-principle__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </p>
                  <h3 class="event-principle__title">{principle.title}</h3>
                  <p class="event-principle__body">{principle.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="section section--dark event-answers" aria-labelledby="event-answers-title">
        <div class="section__inner">
          <div class="event-answers__intro">
            <p class="eyebrow">{questions.eyebrow}</p>
            <h2 id="event-answers-title" class="display display--lg event-answers__title">
              {questions.title}
            </h2>
            <p class="body event-answers__lead">{questions.lead}</p>
          </div>

          <div class="event-answer-groups">
            {
              questionGroups.map((group, groupIndex) => (
                <section
                  class="event-answer-group"
                  id={`answer-group-${group.id}`}
                  aria-labelledby={`answer-group-${group.id}-title`}
                >
                  <header class="event-answer-group__head">
                    <p class="event-answer-group__index" aria-hidden="true">
                      {String(groupIndex + 1).padStart(2, '0')}
                    </p>
                    <h3 id={`answer-group-${group.id}-title`} class="event-answer-group__title">
                      {group.title}
                    </h3>
                    <p class="event-answer-group__lead">{group.lead}</p>
                  </header>

                  <ol class="event-answer-list">
                    {
                      group.items.map((item) => (
                        <li>
                          <article class="event-answer" id={item.id}>
                            <div class="event-answer__rail">
                              <a
                                class="event-answer__number"
                                href={`#${item.id}`}
                                aria-label={`${questions.linkLabel}: ${item.question}`}
                              >
                                {item.number}
                              </a>
                            </div>
                            <div class="event-answer__main">
                              <p class="event-answer__chapter">
                                <span>{questions.chapterLabel}</span>
                                <span aria-hidden="true"> / </span>
                                <a href={item.href} target="_blank" rel="noopener noreferrer">
                                  {item.chapter}
                                  <span class="event-answer__chapter-arrow" aria-hidden="true">
                                    {' '}
                                    ↗
                                  </span>
                                  <span class="sr-only">({copy.a11y.externalLink})</span>
                                </a>
                              </p>
                              <h4 class="event-answer__question">{item.question}</h4>
                              <div class="event-answer__response">
                                <p class="event-answer__label">{questions.answerLabel}</p>
                                <p class="event-answer__text">{item.answer}</p>
                              </div>
                            </div>
                          </article>
                        </li>
                      ))
                    }
                  </ol>
                  {
                    group.quote && (
                      <figure class="event-quote">
                        <blockquote class="event-quote__text">
                          <p>{group.quote.text}</p>
                        </blockquote>
                        <figcaption class="event-quote__by">{group.quote.by}</figcaption>
                      </figure>
                    )
                  }
                </section>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section--event-light event-map" aria-labelledby="event-map-title">
        <div class="section__inner">
          <div class="event-head event-head--split">
            <h2 id="event-map-title" class="display display--md">{map.title}</h2>
            <p class="body event-head__lead">{map.lead}</p>
          </div>

          <div class="event-map__grid">
            <div class="event-axes">
              <h3 class="body--mono event-panel__title">{map.axesTitle}</h3>
              <dl class="event-axes__list">
                {
                  map.axes.map((axis) => (
                    <div class="event-axis" data-axis={axis.id}>
                      <dt class="event-axis__label">{axis.label}</dt>
                      <dd class="event-axis__body">{axis.body}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <div class="event-legend">
              <h3 class="body--mono event-panel__title">{map.legendTitle}</h3>
              <ul class="event-legend__list">
                {
                  archetypes.items.map((item) => {
                    const { width, height } = getArchetypeImageDimensions(item.id);
                    return (
                      <li class="event-legend__item" data-archetype={item.id}>
                        <span class="event-legend__media" aria-hidden="true">
                          <img
                            class="event-legend__art"
                            src={assetPath(item.image, locale, rootPath)}
                            alt=""
                            width={width}
                            height={height}
                            loading="lazy"
                            decoding="async"
                          />
                        </span>
                        <span class="event-legend__name">{item.name}</span>
                        <span class="event-legend__quadrant">{item.quadrant}</span>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--dark event-speakers" aria-labelledby="event-speakers-title">
        <div class="section__inner">
          <div class="event-head event-head--split">
            <h2 id="event-speakers-title" class="display display--md">{speakers.title}</h2>
            <p class="body event-head__lead">{speakers.lead}</p>
          </div>

          <div class="event-speaker-grid">
            {
              speakers.items.map((speaker) => (
                <article class="event-speaker">
                  <img
                    class="event-speaker__photo"
                    src={assetPath(speaker.image, locale, rootPath)}
                    alt={speaker.name}
                    width="146"
                    height="146"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="event-speaker__copy">
                    <h3 class="event-speaker__name">{speaker.name}</h3>
                    <p class="body--mono event-speaker__role">{speaker.role}</p>
                    <p class="body event-speaker__body">{speaker.body}</p>
                    <CtaLink
                      cta={speaker.link}
                      class="btn btn--ghost btn--inline event-speaker__link"
                      externalLabel={copy.a11y.externalLink}
                    />
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section--dark event-close">
        <div class="section__inner event-close__inner">
          {
            event.mottos && (
              <div class="event-mottos">
                <h2 class="body--mono event-mottos__title">{event.mottos.title}</h2>
                <div class="event-mottos__grid">
                  {event.mottos.items.map((motto) => (
                    <figure class="event-motto">
                      <blockquote class="event-motto__text">
                        <p>{motto.text}</p>
                      </blockquote>
                      <figcaption class="event-motto__by">{motto.by}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            )
          }
          <p class="body--sm event-close__source">{event.source}</p>
          <a class="btn btn--quiet" href={rootPath}>{event.homeLabel}</a>
        </div>
      </section>
    </main>

    <SiteFooter copy={copy} />
  </div>
</Base>
