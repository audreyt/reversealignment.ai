---
import {
  absoluteSiteUrl,
  deployedAssetUrl,
  getContent,
  getDefaultLocale,
  getSite,
  hreflangAlternates,
  isIndexableLocale,
  listLocales,
  relativeRootPath,
  toBcp47,
  toOgLocale,
} from '../lib/i18n';
import type { Locale } from '../lib/types';

type Props = {
  title?: string;
  description?: string;
  locale?: Locale;
  /** Site-absolute asset path overriding the locale's default social image. */
  image?: string;
  /**
   * Overrides the locale-derived default. An auth-walled page must opt out even
   * on a locale that owns its whole domain, or the login wall becomes a result.
   */
  robots?: string;
};

const locale = Astro.props.locale ?? getDefaultLocale();
const site = getSite();
const copy = getContent(locale);
const title = Astro.props.title ?? copy.meta.title;
const description = Astro.props.description ?? copy.meta.description;
const canonical = absoluteSiteUrl(Astro.url.pathname, locale);
const siteRoot = absoluteSiteUrl('/', locale);
const ogImage = deployedAssetUrl(Astro.props.image ?? copy.meta.ogImage, locale);
const bcp47 = toBcp47(locale);
const ogLocale = toOgLocale(locale);
const rootPath = relativeRootPath(Astro.url.pathname);
const alternates = hreflangAlternates();
const robots = Astro.props.robots ?? (isIndexableLocale(locale) ? null : 'noindex, follow');
const alternateOgLocales = listLocales()
  .filter((candidate) => candidate !== locale)
  .map(toOgLocale);
/**
 * zh-TW is the only script the Lanyang faces cover, so the
 * loader ships on the zh-TW deployment and nowhere else — every other locale
 * would pay for a webfont service it cannot render a glyph from. The families
 * enter as aliases at the front of the stacks in main.css, gated on
 * `html[lang="zh-TW"]`, so a slow or blocked ds.justfont.com degrades to plfh
 * with nothing hidden in the meantime.
 */
const usesJustfont = locale === 'zh-tw';
---

<!doctype html>
<html lang={bcp47}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }
    <link rel="icon" type="image/png" sizes="512x512" href={`${rootPath}favicon.png`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${rootPath}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    {
      alternateOgLocales.map((alternate) => (
        <meta property="og:locale:alternate" content={alternate} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="stylesheet" href={`${rootPath}assets/css/main.css`} />
    {
      usesJustfont && (
        <Fragment>
          <link rel="preconnect" href="https://ds.justfont.com" crossorigin />
          <script is:inline src={`${rootPath}assets/js/justfont-loader.js`} />
        </Fragment>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.a11y.skipToContent}</a>
    <slot />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: siteRoot,
        description,
        inLanguage: bcp47,
      })}
    />
  </body>
</html>
