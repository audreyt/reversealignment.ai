---
import type { SiteContent } from '../lib/types';

type Props = { copy: SiteContent; showNavigation?: boolean };
const { copy, showNavigation = true } = Astro.props;
const { name } = copy.brand;
if (!name) {
  throw new Error('brand.name is required in content');
}
const navLinks = copy.nav.links.filter(({ id }) =>
  ['idea', 'building', 'papers', 'grants', 'coalition'].includes(id)
);
---

<header class="site-header">
  <a class="brand" href="#top">{name}</a>
  {
    showNavigation && (
      <nav class="site-nav" aria-label="Section navigation">
        {
          navLinks.map((link) => (
            <a href={link.href} data-nav-id={link.id}>{link.label}</a>
          ))
        }
      </nav>
    )
  }
  <a class="btn btn--coalition" href={copy.nav.coalition.href}>{copy.nav.coalition.label}</a>
</header>
